{
  "name": "api",
  "version": "0.0.1",
  "author": "Fiantso Harena",
  "description": "Finoana is a Christian community platform focused on spiritual sharing, mutual support, collective prayer, and uplifting resources, all within a safe, respectful environment free from distracting algorithms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Finoana-App/finoana-app.git"
  },
  "bugs": {
    "url": "https://github.com/Finoana-App/finoana-app/issues"
  },
  "homepage": "https://github.com/Finoana-App/finoana-api#readme",
  "scripts": {
    "build": "tsc && tsup",
    "dev": "node --import=tsx --watch src/index.ts | pino-pretty",
    "start": "node dist/index.js | pino-pretty",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "packageManager": "pnpm@10.4.1",
  "dependencies": {
    "chalk": "^5.6.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/sharp": "^0.32.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/types": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm",
      "cjs"
    ],
    "target": "es2020",
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "splitting": false,
    "skipNodeModulesBundle": true
  }
}
